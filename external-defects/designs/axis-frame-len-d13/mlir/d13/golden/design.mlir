module {
  hw.module @axis_frame_len(in %clk : i1 loc(#loc2), in %rst : i1 loc(#loc3), in %monitor_axis_tkeep : i8 loc(#loc4), in %monitor_axis_tvalid : i1 loc(#loc5), in %monitor_axis_tready : i1 loc(#loc6), in %monitor_axis_tlast : i1 loc(#loc7), out frame_len : i16, out frame_len_valid : i1) {
